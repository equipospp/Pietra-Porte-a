# Copiar como .env.local para probar en la compu, y cargar las mismas dos en Vercel → Settings → Environment Variables.
# Están en Supabase → Project Settings → API. La anon key es pública (la protege la seguridad por filas).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Solo para el script de usuarios (scripts/crear-usuarios.mjs). NUNCA en Vercel ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=
